# Copy to .env and fill in either Resend or SMTP credentials for real email OTP delivery.
RESEND_API_KEY=
EMAIL_FROM=Simple <onboarding@resend.dev>

# Or SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# AI assistant (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
